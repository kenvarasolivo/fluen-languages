# AI Coach — free key from https://aistudio.google.com
GEMINI_API_KEY=

# Supabase email/password accounts, saved words and writing progress
# Use the NEW project's URL and publishable key from its API settings.
# The app needs these even when a database connection string is provided.
# HTTPS project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEW project's service-role key; server-side only (used by backup scripts).
SUPABASE_SERVICE_ROLE_KEY=
# NEW project's PostgreSQL URI from Supabase Dashboard > Connect.
# This is a connection string, NOT the HTTPS project URL above:
# postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# Use Direct connection, or Session pooler (port 5432) for IPv4 networks.
# Replace the password placeholder; URL-encode special password characters.
# Keep real credentials in .env.local, never in this example or NEXT_PUBLIC vars.
# Run npm run supabase:setup to create Fluen tables, constraints and RLS policies.
# For a clean new database, do not use --cleanup-legacy.
SUPABASE_DB_URL=
# Alternative to SUPABASE_DB_URL for schema setup: personal management token.
SUPABASE_ACCESS_TOKEN=

# Voice pipeline (Speak tab voice mode)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
